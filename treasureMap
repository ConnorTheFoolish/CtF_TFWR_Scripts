oppo = {
North:South,
South:North,
East:West,
West:East
}
prefer = {
"TR":[South,West,North,East],
"TL":[South,East,North,West],
"BR":[North,West,South,East],
"BL":[North,East,South,West]
}

def vector(cPos,tPos):
	cX,cY = cPos
	tX,tY = tPos
	if cX >= tX:
		h = "R"
	else:
		h = "L"
	if cY >= tY:
		v = "T"
	else:
		v = "B"
	ans = v + h
	return ans

def getPos():
	return (get_pos_x(),get_pos_y())

def newPos(x,y,dir):
	if dir == North:
		why = y + 1
		eks = x
	elif dir == South:
		why = y - 1
		eks = x
	elif dir == East:
		eks = x + 1
		why = y
	elif dir == West:
		eks = x - 1
		why = y
	return (eks,why)

def DFS(endX,endY):
	
	endPos = (endX,endY)
	visited = set()
	stack = []
	while getPos() != endPos:
		
		currX,currY = getPos()
		visited.add(getPos())
		
		
		fndNewPath = False
		for direction in prefer[vector(getPos(),endPos)]:
			if (get_ground_type(direction) == Grounds.Treasure_Path) and (get_pos_z(direction) == get_pos_z()):
				nxtX,nxtY = newPos(currX,currY,direction)
				if (nxtX,nxtY) not in visited:
					stack.append(oppo[direction])
					move(direction)
					fndNewPath = True
					break
			
		if not fndNewPath:
			backtrack = stack.pop()
			move(backtrack)

